# FindIt 환경변수 예시 — 실제 값은 .env 에 넣으세요 (.env 는 커밋 금지)

# 공공데이터포털 습득물 API 인증키 (디코딩 키)
DATA_GO_KR_SERVICE_KEY_DECODED=여기에_공공데이터포털_디코딩_인증키

# Gemini (임베딩 + LLM grading)
GEMINI_API_KEY=여기에_Gemini_API_키
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# 카카오 로컬(키워드검색) — dep(보관장소) 지오코딩용. gazetteer가 못 잡는 역·랜드마크·상호를 구/시로.
# 발급(무료): https://developers.kakao.com → 내 애플리케이션 → REST API 키. (없어도 gazetteer 86%는 동작)
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키

# PostgreSQL 비밀번호 (배포 docker-compose용). 로컬 SQLite 개발 시엔 불필요.
# 미설정 시 compose 기본값(findit_pw) 사용. 배포에선 강한 값 권장.
POSTGRES_PASSWORD=findit_pw

# 알림 채널: console(기본) | email
NOTIFIER_CHANNEL=console
# 이메일 알림용 SMTP (Gmail 예시). password는 "앱 비밀번호"(2단계 인증 후 발급, 계정 비번 아님).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=여기에_발신_Gmail_주소
SMTP_PASSWORD=여기에_Gmail_앱_비밀번호
NOTIFY_EMAIL_TO=여기에_수신_이메일_주소
